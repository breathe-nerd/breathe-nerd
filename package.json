{
  "name": "breathe-nerd",
  "version": "1.0.0",
  "description": "Breathe Nerd is a low-friction breathing exercise web app for developers and people who work at computers. The goal is simple: open the app, breathe for a short guided exercise, and get back to work.",
  "main": "server/server.ts",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "node --watch --import tsx/esm server/server.ts",
    "dev:client": "vite client",
    "build": "tsc -b && vite build client",
    "preview": "vite preview",
    "start": "node --watch --import tsx/esm server/server.ts",
    "test": "vitest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/breathe-nerd/breathe-nerd.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/breathe-nerd/breathe-nerd/issues"
  },
  "homepage": "https://github.com/breathe-nerd/breathe-nerd#readme",
  "dependencies": {
    "@supabase/supabase-js": "^2.105.4",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/node": "^25.7.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^7.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "cors": "^2.8.6",
    "supertest": "^7.2.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.12",
    "vitest": "^4.1.6"
  }
}